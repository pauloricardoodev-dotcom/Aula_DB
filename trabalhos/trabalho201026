CREATE OR REPLACE VIEW vw_estoque_parado AS
SELECT
    pr.categoria AS Categoria,
    pr.nome AS Produto,
    pr.referencia AS Codigo_Referencia,
    e.quantidade AS Saldo_Estoque,
    (e.quantidade * pr.preco) AS Valor_Financeiro_Paralisado
FROM estoque e
INNER JOIN produto pr
    ON e.produtoId = pr.id
WHERE e.quantidade < 50
ORDER BY e.quantidade ASC;

-- 01: todos os clientes e o que cada um comprou
-- (quem nunca comprou aparece com a venda em NULL)
CREATE OR REPLACE VIEW vw_clientes_e_compras AS
SELECT
    c.id AS cliente_id,
    c.nome AS cliente,
    v.id AS venda_id,
    p.nome AS produto
FROM clientes c
         LEFT JOIN venda v
                   ON v.clienteId = c.id
         LEFT JOIN produto p
                   ON p.id = v.produtoId;


-- 02: clientes cadastrados que nunca fizeram uma compra
CREATE OR REPLACE VIEW vw_clientes_sem_compra AS
SELECT
    c.id AS cliente_id,
    c.nome AS cliente,
    c.doc
FROM clientes c
         LEFT JOIN venda v
                   ON v.clienteId = c.id
WHERE v.id IS NULL;


-- 03: produtos da mesma categoria com o mesmo preço
CREATE OR REPLACE VIEW vw_produtos_mesmo_preco_categoria AS
SELECT
    p1.categoria,
    p1.nome AS produto_1,
    p2.nome AS produto_2,
    p1.preco
FROM produto p1
         INNER JOIN produto p2
                    ON p1.categoria = p2.categoria
                        AND p1.preco = p2.preco
                        AND p1.id < p2.id;


-- 04: clientes sem compra e vendas sem cliente, juntos
CREATE OR REPLACE VIEW vw_clientes_sem_compra_e_vendas_sem_cliente AS
SELECT
    c.id AS cliente_id,
    c.nome AS cliente,
    v.id AS venda_id
FROM clientes c
         LEFT JOIN venda v
                   ON v.clienteId = c.id
UNION
SELECT
    c.id AS cliente_id,
    c.nome AS cliente,
    v.id AS venda_id
FROM clientes c
         RIGHT JOIN venda v
                    ON v.clienteId = c.id;


-- 05: faturamento por categoria, só das que passaram de R$ 100
CREATE OR REPLACE VIEW vw_faturamento_categorias_acima_100 AS
SELECT
    p.categoria,
    COUNT(v.id) AS qtd_vendas,
    SUM(p.preco) AS faturamento
FROM venda v
         INNER JOIN produto p
                    ON p.id = v.produtoId
GROUP BY p.categoria
HAVING SUM(p.preco) > 100;


-- 06: os 3 produtos mais caros da loja
CREATE OR REPLACE VIEW vw_top3_produtos_mais_caros AS
SELECT
    nome AS produto,
    categoria,
    preco
FROM produto
ORDER BY preco DESC
    LIMIT 3;


-- 07: produtos com preço acima da média
CREATE OR REPLACE VIEW vw_produtos_acima_media_preco AS
SELECT
    nome AS produto,
    preco
FROM produto
WHERE preco > (SELECT AVG(preco) FROM produto);


-- 08: comissão de cada vendedor sobre as vendas já pagas
CREATE OR REPLACE VIEW vw_comissao_vendedor_vendas_pagas AS
SELECT
    ve.nome AS vendedor,
    SUM(pr.preco) AS total_vendido,
    SUM(pr.preco) * ve.comissao AS comissao
FROM venda v
INNER JOIN pagamento pg
    ON pg.id = v.pagamentoId
INNER JOIN produto pr
    ON pr.id = v.produtoId
INNER JOIN vendedor ve
    ON ve.id = v.vendedorId
WHERE pg.state = 'PAGO'
GROUP BY ve.id, ve.nome, ve.comissao;


-- 09: ranking de preço dentro de cada categoria
-- (CAMISA e CAMISETA têm o mesmo preço e empatam)
CREATE OR REPLACE VIEW vw_ranking_preco_por_categoria AS
SELECT
    p1.categoria,
    p1.nome AS produto,
    p1.preco,
    (SELECT COUNT(*)
     FROM produto p2
     WHERE p2.categoria = p1.categoria
       AND p2.preco > p1.preco) + 1 AS posicao
FROM produto p1;


-- 10: faturamento acumulado, venda após venda
CREATE OR REPLACE VIEW vw_faturamento_acumulado_vendas AS
SELECT
    v.id AS venda_id,
    p.nome AS produto,
    p.preco,
    (SELECT SUM(p2.preco)
     FROM venda v2
     INNER JOIN produto p2
         ON p2.id = v2.produtoId
     WHERE v2.id <= v.id) AS faturamento_acumulado
FROM venda v
INNER JOIN produto p
    ON p.id = v.produtoId;


DROP PROCEDURE IF EXISTS sp_popular_produto;
DELIMITER %%

CREATE PROCEDURE sp_popular_produto(IN carga INT)
BEGIN
    DECLARE i      INT    DEFAULT 0;
    DECLARE ultimo BIGINT DEFAULT 0;

    -- validação do parâmetro
    IF carga IS NULL OR carga <= 0 THEN
        SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'carga deve ser maior que zero';
    END IF;

    -- maior ID atual (0 se a tabela estiver vazia)
    SELECT COALESCE(MAX(id), 0) INTO ultimo FROM produto;

    START TRANSACTION;

    WHILE i < carga DO
        SET i = i + 1;

        INSERT INTO produto
            (id, nome, preco, categoria, referencia)
        SELECT
            ultimo + i,                                      -- ID manual
            CONCAT('Produto - ', ultimo + i),
            ROUND(10 + RAND() * 90, 2),
            ELT(FLOOR(1 + RAND() * 2), 'ROUPA', 'LANGERIE'),
            10000000 + ultimo + i;
    END WHILE;

    COMMIT;
END%%
DELIMITER ;

